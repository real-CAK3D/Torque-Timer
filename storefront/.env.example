# ---- Owner login (required) ----
ADMIN_PASSWORD=pick-a-strong-password
# Any long random string. Signs the login cookie. (openssl rand -hex 32)
AUTH_SECRET=

# ---- Stripe (cards, Apple Pay, Google Pay) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Storage (added automatically when you connect them in Vercel → Storage) ----
# Upstash Redis — saves products, orders, settings, analytics
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel Blob — stores uploaded images
BLOB_READ_WRITE_TOKEN=

# ---- Phone notifications (run `npm run vapid` to make these) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Public address of the site, e.g. https://yourshop.vercel.app (optional; detected automatically on Vercel)
NEXT_PUBLIC_SITE_URL=
