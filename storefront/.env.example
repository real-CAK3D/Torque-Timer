# Only these two are needed to start. Set them in Vercel → Settings → Environment Variables
# (the Deploy button asks for them). Everything else can be pasted into Dashboard → Keys.
ADMIN_PASSWORD=pick-a-strong-password
AUTH_SECRET=any-long-random-text-40-plus-characters

# ---- Supabase: filled in automatically when you connect Supabase in Vercel → Storage ----
SUPABASE_URL=
SUPABASE_SECRET_KEY=
POSTGRES_URL_NON_POOLING=

# ---- Optional: set here instead of Dashboard → Keys (these win over the dashboard) ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# RESEND_API_KEY=re_...
# VAPID_SUBJECT=mailto:owner@example.com
# NEXT_PUBLIC_SITE_URL=https://yourshop.com

# ---- Optional alternatives to Supabase (only if you'd rather use these) ----
# KV_REST_API_URL= / KV_REST_API_TOKEN=   (Upstash Redis for data)
# BLOB_READ_WRITE_TOKEN=                  (Vercel Blob for photos)
